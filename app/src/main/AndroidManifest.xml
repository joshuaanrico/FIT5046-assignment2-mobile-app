<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to fire alarms at an exact time on Android 12+ (user can revoke in Settings) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Stronger exact alarm permission for Android 13+ - auto-granted, user cannot revoke -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Required to show notification popups on Android 13+ - prompted at runtime in MainActivity -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required to reschedule alarms after device reboot, since Android wipes all alarms on power-off -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ass2">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ass2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakes up when a scheduled alarm fires and shows the reminder notification.
             exported=false: only this app can trigger it - external apps cannot send fake alarm broadcasts -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false"/>
        <!-- Wakes up on device boot to reschedule all reminders.
             exported=true: must be accessible to the system so it can deliver BOOT_COMPLETED -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>